# Paste the extension ID from chrome://extensions or edge://extensions.
EXTENSION_ID=

# Journey Agent: enabled staging origins, comma-separated. No wildcard or production target.
# The default is the local synthetic buggy/fixed checkout demo.
JOURNEY_ALLOWED_ORIGINS=http://127.0.0.1:8765
# Optional: local Ollama only; model installation is separate and currently deferred.
JOURNEY_OLLAMA_URL=http://127.0.0.1:11434
# Optional: JOURNEY_BROWSER_EXECUTABLE=C:/path/to/chrome.exe
# Optional: JOURNEY_DATA_DIR=data/journeys
